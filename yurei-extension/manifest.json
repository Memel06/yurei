{
  "manifest_version": 3,
  "name": "Yurei",
  "version": "0.4.0",
  "description": "Your AI, haunting your browser. Lets any AI tool that speaks MCP browse, click and type in the Chrome you already use.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["debugger", "scripting", "tabs", "storage", "alarms", "nativeMessaging", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yurei"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/indicator.js"],
      "run_at": "document_idle"
    }
  ]
}
