    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
