{
  "name": "yurei",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "yurei-extension",
    "yurei-kit"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "typecheck": "npm run typecheck -ws && tsc -p test/tsconfig.json",
